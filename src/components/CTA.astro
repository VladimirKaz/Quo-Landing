---
import NewsletterForm from "@/components/ui/NewsletterForm.astro";
import CtaBg from "@/assets/images/cta/cta-bg.svg";
import { Image } from "astro:assets";

const ctaTitle = "Get connected with Quo and enjoy a new experience";
---

<section class="cta-section">
  <div class="container">
    <div class="cta-card">
      <!-- Декоративные фоновые элементы (круги) -->
      <Image
        src={CtaBg}
        alt={"Cta bg"}
        loading={"lazy"}
        class={"cta-bg-image"}
      />

      <div class="cta-content">
        <h2 class="cta-title">{ctaTitle}</h2>

        <!-- Form to CTA -->
        <NewsletterForm />
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 180px 0;

    background-color: #ffffff;
    font-family: var(--font-hanken-grotesk);

    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Основная фиолетовая карточка */
  .cta-card {
    max-width: 1500px;
    width: 100%;
    margin: 0 auto;
    background-color: #5551e6;
    border-radius: 20px;
    padding: 66px 0 69px 0;
    position: relative;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .cta-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 1;
    pointer-events: none;
  }

  /* Контентный блок внутри карточки */
  .cta-content {
    position: relative;
    z-index: 2;
    text-align: center;
    max-width: 1500px;
    width: 100%;

    display: flex;
    flex-direction: column;
    gap: 43px;
  }

  .cta-title {
    font-weight: 600;
    font-size: clamp(32px, 4vw, 60px);
    line-height: 142%;
    text-align: center;
    color: #fff;

    max-width: 800px;
    margin: 0 auto;
  }

  .cta-button:active {
    transform: scale(0.98);
  }

  /* --- Декоративные фоновые круги (CSS замена графики) --- */
  .bg-circle {
    position: absolute;
    background-color: rgba(255, 255, 255, 0.08); /* Полупрозрачный белый */
    border-radius: 50%;
    pointer-events: none; /* Чтобы круги не мешали кликам */
  }

  .bg-circle-1 {
    width: 250px;
    height: 250px;
    left: -60px;
    top: -60px;
  }

  .bg-circle-2 {
    width: 180px;
    height: 180px;
    left: 120px;
    bottom: -90px;
  }

  .bg-circle-3 {
    width: 220px;
    height: 220px;
    right: -40px;
    bottom: -40px;
  }

  /* --- Адаптивность для мобильных экранов --- */
  @media (max-width: 1024px) {
    .cta-section {
      padding: 40px 40px;
    }
    .cta-title {
      font-size: 1.8rem;
    }
  }

  @media (max-width: 600px) {
    .cta-section {
      padding: 30px 20px;
    }
    .cta-card {
      padding: 50px 15px;
    }
    .cta-title {
      font-size: 1.5rem;
      margin-bottom: 30px;
    }
  }
</style>
